# passwords.yaml.example を passwords.yaml にコピーして値を入れる。
# passwords.yaml は Git 管理外。実値を入れたファイルをコミットしない。
# 各値は 32 文字以上のランダム文字列にする（例: openssl rand -base64 32）。
#
# production は Secret Manager から環境変数で注入する。変数名は
# SERVERPOD_PASSWORD_ に、下のキー名をそのまま（大文字化せず）続ける。
#   SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey
#   SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper
development:
  jwtHmacSha512PrivateKey: ''
  jwtRefreshTokenHashPepper: ''
test:
  jwtHmacSha512PrivateKey: ''
  jwtRefreshTokenHashPepper: ''
production:
  jwtHmacSha512PrivateKey: ''
  jwtRefreshTokenHashPepper: ''
