# ローカル実行環境の設定。`cp .env.example .env.local` で使う（.env.local は Git 管理外）。
# キーは docs/specs.md「設定値」＋ローカル専用の追加分。

# --- ローカル専用（compose のポートとホスト名） ---
# ホスト側の公開ポート。衝突したらここだけ変える。
API_HOST_PORT=8080
GCS_HOST_PORT=4443
# fake-gcs-server が自分の URL として名乗るホスト。実行先に合わせて変える（README「アプリからの接続」）。
GCS_PUBLIC_HOST=localhost:4443

# --- API ---
RELEASE_ID=local
PORT=8080
API_BASE_URL=http://localhost:8080/

# --- Serverpod 認証の秘密（ローカル専用のダミー値。本番は Secret Manager） ---
# 変数名は SERVERPOD_PASSWORD_ + passwords.yaml のキー名。32 文字以上にする。
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=local-only-jwt-hmac-sha512-private-key-0123456789
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=local-only-jwt-refresh-token-hash-pepper-0123456789

# --- GCS emulator（ローカルだけで設定する。compose の api / migrate / seed は http://gcs:4443 を上書きで渡す） ---
STORAGE_EMULATOR_HOST=http://localhost:4443

# --- DB / Litestream ---
# 複製先は compose が選ぶ（LITESTREAM_CONFIG）。ローカルは volume、本番は GCS。
# DB_REPLICA_BUCKET は writer 所有権（GCS）の置き場。DB_REPLICA_PREFIX は複製先の prefix。
DB_REPLICA_BUCKET=photohunt-db-local
DB_REPLICA_PREFIX=replica/local
# DB_REPLICA_BUCKET 内。レプリカとは別 prefix
DB_WRITER_OWNER_OBJECT=owner/local/writer.json
LITESTREAM_SOCKET_PATH=/var/run/litestream.sock
MAINTENANCE_MODE=false

# --- 素材 ---
ASSET_BUCKET=photohunt-media-local
# 匿名で GET できる URL の形式は http://<GCS_PUBLIC_HOST>/<バケット>/<オブジェクト>。
# ホストは GCS_PUBLIC_HOST と、端末から届く値（README の表）に揃える。
ASSET_BASE_URL=http://localhost:4443/photohunt-media-local/

# --- 匿名作成の制限（Dockerでは接続元IPが共通になるため、ローカルだけ緩和） ---
# Cloud Runでは100件/時を超える設定を拒否する。
ANON_SIGNUP_LIMIT_PER_HOUR=1000

# --- ガイド ---
GUIDES_ENABLED=true
GUIDE_BACKEND=fake
# ローカルは fake だけ。下の Vertex AI・Gemini の設定は GUIDE_BACKEND=gemini のときだけ使う。
VERTEX_PROJECT_ID=
VERTEX_LOCATION=global
GEMINI_TEXT_MODEL=
GEMINI_TEXT_THINKING_LEVEL=
GEMINI_TTS_MODEL=
GUIDE_PROMPT_VERSION=local
GUIDE_VOICE_ID=
